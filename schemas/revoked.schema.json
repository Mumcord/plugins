{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Mumcord/plugins/schemas/revoked.schema.json",
  "title": "revoked.toml",
  "description": "Kill switch entries; published as v1/revoked.json. Reference: docs/plugin-registry-format.md in Mumcord/mumcord.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "revoked": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "severity", "reason", "since"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{2,31}$" },
          "versions": { "type": "array", "items": { "type": "string", "minLength": 1 } },
          "sha256": { "type": "array", "items": { "type": "string", "pattern": "^[0-9a-f]{64}$" } },
          "author_key": { "type": "string", "pattern": "^RW[A-Za-z0-9+/]{54}$" },
          "severity": { "enum": ["disable", "warn"] },
          "reason": {
            "type": "object",
            "required": ["en"],
            "additionalProperties": { "type": "string", "minLength": 1 }
          },
          "since": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" }
        }
      }
    }
  }
}
