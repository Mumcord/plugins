    "@eveshipfit/sde": "14.3662168.3",
    "@eveshipfit/sde-loader": "4.0.0",
    "@eveshipfit/ui-ingame": "1.11.1",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "flatbuffers": "25.9.23",
    "sharp": "0.35.5",
